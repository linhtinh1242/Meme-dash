-- Xử lý Logic chính
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    if hum and root then
        if getgenv().MemeDashConfig.SpeedHack then
            hum.WalkSpeed = getgenv().MemeDashConfig.WalkSpeed
        end

        -- Điều khiển bàn phím ảo WASD + SPACE
        if getgenv().MemeDashConfig.VirtualPC then
            local moveDir = Vector3.new(0, 0, 0)
            if pcState.W then moveDir = moveDir + Vector3.new(0, 0, -1) end
            if pcState.S then moveDir = moveDir + Vector3.new(0, 0, 1) end
            if pcState.A then moveDir = moveDir + Vector3.new(-1, 0, 0) end
            if pcState.D then moveDir = moveDir + Vector3.new(1, 0, 0) end
            
            if moveDir.Magnitude > 0 then
                hum:Move(moveDir.Unit, true)
            end

            if pcState.Space and hum.FloorMaterial ~= Enum.Material.Air then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end

        -- Wall Fling
        if getgenv().MemeDashConfig.WallFling then
            pcall(function()
                for _, p in pairs(root:GetTouchingParts()) do
                    if not p:IsDescendantOf(char) and p.CanCollide then
                        root.AssemblyLinearVelocity = root.CFrame.LookVector * 150 + Vector3.new(0, 50, 0)
                    end
                end
            end)
        end

        if getgenv().MemeDashConfig.AutoJump and hum.FloorMaterial ~= Enum.Material.Air and not getgenv().MemeDashConfig.AutoFarmLevel then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end

        if getgenv().MemeDashConfig.AutoFarmLevel then
            if not AirPosition then AirPosition = root.Position + Vector3.new(0, 60, 0) end
            root.CFrame = CFrame.new(AirPosition)
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end

    if getgenv().MemeDashConfig.RemoveWalls then
        pcall(function()
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Transparency >= 0.99 and obj.CanCollide then
                    obj.CanCollide = false
                end
            end
        end)
    end

    if getgenv().MemeDashConfig.Noclip then
        for _, p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
end)

